@{
    var active = ViewData["ActivePage"] as string ?? "/";
    var nav = new[] {
        ("/", "HOME"),
        ("/stats", "SERVER"),
        ("/armory", "ARMORY"),
        ("/events", "EVENTS"),
        ("/commands", "GUIDE")
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#090b10">
    <title>@ViewData["Title"] — MU Online</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/en.js"></script>
    <script src="/content.js"></script>
    <script src="/lang.js" data-default="en"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <div class="site-shell">
        <header class="site-header">
            <a class="brand" href="/">
                <span class="brand-mark">MU</span>
                <span class="brand-copy">
                    <strong>MU ONLINE</strong>
                    <small>ADVENTURE NEVER ENDS</small>
                </span>
            </a>
            <nav class="main-nav">
                @foreach (var item in nav)
                {
                    <a href="@item.Item1" class="@(active == item.Item1 ? "active" : "")">@item.Item2</a>
                }
            </nav>
            <div class="header-actions">
                <a class="header-login" href="/changepass">ACCOUNT</a>
                <a class="header-register" href="/register">CREATE ACCOUNT <span>↗</span></a>
            </div>
        </header>

        <main>
            @RenderBody()
        </main>

        <footer class="site-footer">
            <div class="footer-brand"><span class="brand-mark">MU</span> MU ONLINE</div>
            <div class="footer-copy">A world of legends. Your adventure starts here.</div>
            <div class="footer-links">
                <a href="/register">REGISTER</a>
                <a href="/stats">SERVER STATUS</a>
                <a href="/commands">COMMANDS</a>
            </div>
            <div class="footer-bottom">© @DateTime.UtcNow.Year MU ONLINE COMMUNITY. ALL RIGHTS RESERVED.</div>
        </footer>
    </div>

    @await RenderSectionAsync("BodyEnd", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
